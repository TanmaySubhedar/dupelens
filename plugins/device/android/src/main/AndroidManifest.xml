<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- "All files access" (Android 11 and newer): lets DupeLens read every folder on the
         phone. The person turns it on in Android's settings; it is never granted silently.
         Decision 0016, item 5 (the direct-APK flavour). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Before Android 11 the ordinary storage permissions are the way in. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
</manifest>
